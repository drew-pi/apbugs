---
import { withBase } from '@lib/withBase';
import '@styles/main.css';

interface Props {
	title?: string;
}

const { title = 'Andrew Piatetsky' } = Astro.props;

const links = [
	{ href: '/projects', label: 'Projects' },
	{ href: '/experience', label: 'Experience' },
	{ href: '/about', label: 'About' },
];

const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const currentPath = normalize(Astro.url.pathname);
const isActive = (target: string) => {
	const full = normalize(withBase(target));
	return target === '/' ? currentPath === full : currentPath === full || currentPath.startsWith(`${full}/`);
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.ico')} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<nav class="site-nav">
			<a href={withBase('/')} class="nav-home" aria-current={isActive('/') ? 'page' : undefined}>Home</a>
			<div class="nav-links">
				{links.map(({ href, label }) => (
					<a href={withBase(href)} class="nav-link" aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
				))}
			</div>
		</nav>
		<slot />
	</body>
</html>

<style>
	nav.site-nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		row-gap: 0.5rem;
		column-gap: 1rem;
		padding: 1.25rem 2rem;
		border-bottom: 1px solid #e5e5e5;
	}

	.nav-home {
		color: black;
		text-decoration: none;
		font-weight: 700;
		font-size: 1.05rem;
		letter-spacing: 0.01em;
		padding-bottom: 0.3rem;
		border-bottom: 2px solid transparent;
	}

	.nav-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.75rem;
	}

	.nav-link {
		color: #555;
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95rem;
		padding-bottom: 0.3rem;
		border-bottom: 2px solid transparent;
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	.nav-link:hover {
		color: black;
	}

	.nav-home[aria-current='page'],
	.nav-link[aria-current='page'] {
		color: #c56b3b;
		border-color: #c56b3b;
	}

	@media (max-width: 480px) {
		nav.site-nav {
			justify-content: center;
			text-align: center;
		}

		.nav-links {
			justify-content: center;
			gap: 1.25rem;
		}
	}
</style>

<style is:global>
	html {
		height: 100%;
		scroll-behavior: smooth !important;
		scroll-snap-type: y mandatory;
		overflow-y: scroll;
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		margin: 0;
		padding: 0;
	}

	p {
		padding: 0;
		margin: 0;
	}
</style>
